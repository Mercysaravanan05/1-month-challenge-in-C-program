#include <stdio.h>
#include <math.h>

int main()
{
    int n, temp, rem, digits = 0, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    while (temp != 0)
    {
        digits++;
        temp /= 10;
    }

    temp = n;

    while (temp != 0)
    {
        rem = temp % 10;
        sum += pow(rem, digits);
        digits--;
        temp /= 10;
    }

    if (sum == n)
        printf("Disarium Number");
    else
        printf("Not Disarium Number");

    return 0;
}
