#include <stdio.h>

int main() {
  int n,i,temp,r,sum=0,fact;
  scanf("%d",&n);
  temp=n;
  while(temp!=0){
      r=temp%10;
      fact=1;
      for(i=1;i<=r;i++){
          fact=fact*i;
      }
       sum=sum+fact;
       temp=temp/10;
     
  }
     if(sum==n)
      printf("Strong no");
 
     else
      printf("Not strong no");
 
 
return 0;
}
