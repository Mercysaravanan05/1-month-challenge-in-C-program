#include <stdio.h>

int main()
{
    int n, rem, sum = 0, product = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    while (n != 0)
    {
        rem = n % 10;
        sum += rem;
        product *= rem;
        n /= 10;
    }

    if (sum == product)
        printf("Spy Number");
    else
        printf("Not Spy Number");

    return 0;
}
