#include <stdio.h>

int main()
{
    int n,temp,rev=0,rem,i,prime=1;

    printf("Enter number: ");
    scanf("%d",&n);

    temp=n;

    while(temp!=0)
    {
        rem=temp%10;
        rev=rev*10+rem;
        temp/=10;
    }

    for(i=2;i<n;i++)
    {
        if(n%i==0)
        {
            prime=0;
            break;
        }
    }

    if(prime&&rev==n)
        printf("Prime Palindrome");
    else
        printf("Not Prime Palindrome");

    return 0;
}
