#include<stdio.h>
int main(){
    int n,i,prime=1;
    printf("Enter num:");
    scanf("%d",&n);
    if(n<=1){
        printf("Not prime");
        return 0;
    }
    for(i=2;i<=n;i++){
        if(n%i==0)
        prime=0;
        break;
    }
    if(prime){
        printf("it's prime");
    }
    else{
        printf("it's not prime");
    }
}
