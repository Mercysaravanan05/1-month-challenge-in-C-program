#include<stdio.h>
int main(){
    int i,n,temp,r,sum=0;
    printf("Enter No:");
    scanf("%d",&n);
    temp=n;
    while(temp!=0){
        r=temp%10;
        sum=sum*10+r;
        temp=temp/10;
    }
    if(n==sum){
        printf("Palindrome Number");
    }
    else{
        printf("not Palindrome Number");
    }
return 0;
}
